<Application
    x:Class="PaqetFire.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="PaqetFireAccentBrush" Color="#FF6B42" />
      <SolidColorBrush x:Key="PaqetFireSuccessBrush" Color="#2FCB8C" />
      <SolidColorBrush x:Key="PaqetFireWarningBrush" Color="#F5A524" />
      <SolidColorBrush x:Key="PaqetFireErrorBrush" Color="#E5484D" />
      <SolidColorBrush x:Key="PaqetFireNeutralBrush" Color="#8A8F98" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
